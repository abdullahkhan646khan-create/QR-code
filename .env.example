# All optional when running locally.
PORT=3000
# Postgres connection. Leave empty to use the built-in local database in ./.data
DATABASE_URL=
# Set to true for hosted Postgres that needs SSL from outside (Supabase, Neon). Not needed on Render.
PGSSL=false
SESSION_SECRET=change-me
ADMIN_USERNAME=owner
ADMIN_PASSWORD=owner123
GYM_NAME=Demo Fitness Club
APP_TIMEZONE=Asia/Karachi
DEFAULT_COUNTRY_CODE=92
# Adds 3 sample trainers and 7 members on first start. Set to false for a real gym.
SEED_DEMO=true
# Full public link of the app, used in QR codes. Render sets RENDER_EXTERNAL_URL automatically.
PUBLIC_URL=
