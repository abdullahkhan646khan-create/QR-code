{
  "name": "trainer-pass",
  "version": "1.0.0",
  "private": true,
  "description": "Gym trainer QR passes: owner and trainer logins, QR codes sent on WhatsApp, and a scanner that shows the member's trainer and expiry.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "baileys": "^7.0.0-rc14",
    "express": "^5.2.1",
    "jsqr": "1.4",
    "pino": "^10.4.0",
    "qrcode": "1.5"
  }
}
